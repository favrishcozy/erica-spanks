// LazyVideo component for efficient video loading and playback
interface LazyVideoProps {
  src: string;
  className?: string;
  onError?: () => void;
}

const LazyVideo: React.FC<LazyVideoProps> = ({ src, className, onError }) => {
  const videoRef = React.useRef<HTMLVideoElement>(null);

  React.useEffect(() => {
    const video = videoRef.current;
    if (!video) return;

    let observer: IntersectionObserver | null = null;
    
    try {
      // Use a slightly lower threshold so small thumbnails trigger play
      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!video) return;

          if (entry.isIntersecting) {
            video.play().catch(error => {
              console.warn('Video autoplay failed:', error);
            });
          } else {
            video.pause();
          }
        });
      }, { threshold: 0.1 });
      
      observer.observe(video);
    } catch (error) {
      console.warn('IntersectionObserver failed:', error);
    }

    return () => {
      if (observer) {
        observer.disconnect();
      }
    };
  }, [src]);

  return (
    <video
      ref={videoRef}
      className={className}
      src={src}
      playsInline
      muted
      loop
      preload="metadata"
      onError={onError}
      style={{ width: '100%', height: '100%', objectFit: 'cover' }}
    />
  );
};

// HeroSlideshow component that cycles between video and images - FIXED VERSION
interface HeroSlideshowProps {
  className?: string;
}

const HeroSlideshow: React.FC<HeroSlideshowProps> = ({ className }) => {
  const [currentIndex, setCurrentIndex] = React.useState(0);
  const mediaRef = React.useRef<HTMLVideoElement | HTMLImageElement>(null);

  // CORRECTED: Use only hero-specific media items
  const heroMediaItems = [
    fashionVideo2, // This is your hero video
    'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501832/erica-spanks/undefined/Dress_waw3fm.jpg',
    'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501837/erica-spanks/undefined/Top_onrpuu.jpg'
  ];

  React.useEffect(() => {
    const interval = setInterval(() => {
      setCurrentIndex((prevIndex) => (prevIndex + 1) % heroMediaItems.length);
    }, 5000); // Change every 5 seconds

    return () => clearInterval(interval);
  }, []);

  React.useEffect(() => {
    const currentMedia = heroMediaItems[currentIndex];
    const isVideo = typeof currentMedia === 'string' && /\.(mp4|webm|ogg)$/i.test(currentMedia);

    if (isVideo && mediaRef.current) {
      (mediaRef.current as HTMLVideoElement).play().catch(error => {
        console.log('Video autoplay blocked by browser');
      });
    }
  }, [currentIndex]);

  const currentMedia = heroMediaItems[currentIndex];
  const isVideo = typeof currentMedia === 'string' && /\.(mp4|webm|ogg)$/i.test(currentMedia);

  return isVideo ? (
    <video
      ref={mediaRef as React.RefObject<HTMLVideoElement>}
      className={className}
      src={currentMedia}
      playsInline
      muted
      loop
      preload="auto"
      style={{ width: '100%', height: '100%', objectFit: 'cover' }}
    />
  ) : (
    <img
      ref={mediaRef as React.RefObject<HTMLImageElement>}
      className={className}
      src={currentMedia}
      alt="hero"
      style={{ width: '100%', height: '100%', objectFit: 'cover' }}
    />
  );
};

// RunwaySlideshow component for the Runway & Lookbook section - UPDATED FOR CLARITY
interface RunwaySlideshowProps {
  className?: string;
}

const RunwaySlideshow: React.FC<RunwaySlideshowProps> = ({ className }) => {
  const [currentIndex, setCurrentIndex] = React.useState(0);
  const mediaRef = React.useRef<HTMLVideoElement | HTMLImageElement>(null);

  // EXPLICITLY define runway-only media items
  const runwayMediaItems = [
    fashionVideo1, // This is your runway video (different from hero)
    'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501853/erica-spanks/undefined/Two-piece_lydbu8.jpg',
    'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501853/erica-spanks/undefined/Two-piece2_ekz4s7.jpg',
    'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501853/erica-spanks/undefined/Two-piece3_ii4cvw.jpg'
  ];

  React.useEffect(() => {
    const interval = setInterval(() => {
      setCurrentIndex((prevIndex) => (prevIndex + 1) % runwayMediaItems.length);
    }, 4000); // Change every 4 seconds

    return () => clearInterval(interval);
  }, []);

  React.useEffect(() => {
    const currentMedia = runwayMediaItems[currentIndex];
    const isVideo = typeof currentMedia === 'string' && /\.(mp4|webm|ogg)$/i.test(currentMedia);

    if (isVideo && mediaRef.current) {
      (mediaRef.current as HTMLVideoElement).play().catch(error => {
        console.log('Runway video autoplay blocked by browser');
      });
    }
  }, [currentIndex]);

  const currentMedia = runwayMediaItems[currentIndex];
  const isVideo = typeof currentMedia === 'string' && /\.(mp4|webm|ogg)$/i.test(currentMedia);

  return isVideo ? (
    <video
      ref={mediaRef as React.RefObject<HTMLVideoElement>}
      className={className}
      src={currentMedia}
      playsInline
      muted
      loop
      preload="auto"
      style={{ width: '100%', height: '100%', objectFit: 'cover' }}
    />
  ) : (
    <img
      ref={mediaRef as React.RefObject<HTMLImageElement>}
      className={className}
      src={currentMedia}
      alt="runway"
      style={{ width: '100%', height: '100%', objectFit: 'cover' }}
    />
  );
};

// VideoWithFallback: tries to render a lazy-playing video, falls back to an image when video fails
const VideoWithFallback: React.FC<{ 
  src?: string; 
  fallbackImage?: string; 
  className?: string; 
  style?: React.CSSProperties;
  onError?: () => void;
  onLoad?: () => void;
}> = ({ src, fallbackImage, className, style, onError, onLoad }) => {
  const [videoFailed, setVideoFailed] = React.useState(false)

  if (!src || videoFailed) {
    return fallbackImage ? <MediaImage src={fallbackImage} alt="fallback" style={style} /> : null
  }

  return (
    <LazyVideo 
      src={src} 
      className={className}
      onError={() => {
        console.error('Video failed to load:', src);
        setVideoFailed(true);
        onError?.();
      }}
    />
  )
}

