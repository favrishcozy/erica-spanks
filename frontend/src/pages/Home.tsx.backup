const Home: React.FC = () => {
  const [email, setEmail] = useState('')
  const [featuredProducts, setFeaturedProducts] = useState<Product[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [newsletterLoading, setNewsletterLoading] = useState(false)
  const [newsletterMessage, setNewsletterMessage] = useState<{ type: 'success' | 'error'; text: string } | null>(null)

  // Helper function to transform API data to Product structure
  const transformProductData = (data: any): Product => {
    return {
      _id: data._id || data.id || '',
      name: data.name || 'Unnamed Product',
      price: Number(data.price) || 0,
      originalPrice: data.originalPrice ? Number(data.originalPrice) : undefined,
      images: Array.isArray(data.images) ? data.images : [data.image || 'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501832/erica-spanks/undefined/Dress_waw3fm.jpg'],
      colors: Array.isArray(data.colors) ? data.colors : [],
      sizes: Array.isArray(data.sizes) ? data.sizes : [],
      rating: Number(data.rating) || 0,
      reviewCount: Number(data.reviewCount) || 0,
      isNew: Boolean(data.isNew),
      isSale: Boolean(data.isSale),
      category: data.category || 'Uncategorized',
      description: data.description || '',
      slug: data.slug || data._id || data.id || '',
      inStock: data.inStock !== undefined ? Boolean(data.inStock) : true,
      featured: Boolean(data.featured),
      tags: Array.isArray(data.tags) ? data.tags : [],
    }
  }

  // Load featured products from API
  const loadFeaturedProducts = async () => {
    try {
      setLoading(true)
      setError(null)
      console.log('Loading featured products...')
      
      let response;
      let productsData: any[] = []

      try {
        // First try the featured products endpoint
        response = await productAPI.getFeaturedProducts()
        console.log('Featured products API response:', response)
        
        // Handle different response structures
        if (response && Array.isArray(response)) {
          productsData = response
        } else if (response && response.data && Array.isArray(response.data)) {
          productsData = response.data
        } else if (response && response.products && Array.isArray(response.products)) {
          productsData = response.products
        }
      } catch (featuredError) {
        console.warn('Featured products endpoint failed, trying regular products...', featuredError)
        
        // Fallback to regular products with limit
        try {
          response = await productAPI.getProducts({ limit: 4, featured: true })
          
          if (response && Array.isArray(response)) {
            productsData = response
          } else if (response && response.data && Array.isArray(response.data)) {
            productsData = response.data
          } else if (response && response.products && Array.isArray(response.products)) {
            productsData = response.products
          }
        } catch (productsError) {
          console.warn('Regular products endpoint also failed, using mock data...', productsError)
          throw new Error('All API endpoints failed')
        }
      }

      // Transform and set products
      if (productsData.length > 0) {
        const transformedProducts = productsData.map(transformProductData)
        setFeaturedProducts(transformedProducts)
        console.log('Successfully loaded products:', transformedProducts.length)
      } else {
        console.warn('No products found in API response, using mock data')
        setFeaturedProducts(mockFeaturedProducts)
      }

    } catch (err) {
      console.error('Error loading featured products:', err)
      setError('Unable to load featured products at the moment. Showing sample products instead.')
      setFeaturedProducts(mockFeaturedProducts)
    } finally {
      setLoading(false)
    }
  }

  const [featuredCategories, setFeaturedCategories] = useState(() => ([
    {
      title: 'New Arrivals',
      description: 'Fresh styles that define confidence',
      link: '/products?sort=newest&category=all',
      mediaCandidates: [
        fashionVideo2,
        'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501832/erica-spanks/undefined/Lounge3_ozyyqs.jpg',
        'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501832/erica-spanks/undefined/Dress_waw3fm.jpg'
      ],
      slug: 'dresses'
    },
    {
      title: 'Best Sellers',
      description: 'Customer favorites that never disappoint',
      link: '/products?sort=popular&category=all',
      mediaCandidates: [
        fashionVideo2,
        'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501837/erica-spanks/undefined/Top2_hserim.jpg',
        'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501837/erica-spanks/undefined/Top_onrpuu.jpg'
      ],
      slug: 'tops'
    },
    {
      title: 'Collections',
      description: 'Curated looks for every occasion',
      link: '/products?category=all',
      mediaCandidates: [
        'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501853/erica-spanks/undefined/Two-piece_lydbu8.jpg',
        'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501853/erica-spanks/undefined/Two-piece2_ekz4s7.jpg',
        'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501853/erica-spanks/undefined/Two-piece3_ii4cvw.jpg'
      ],
      slug: 'two-piece-sets'
    }
  ]))

  useEffect(() => {
    // Load manifest in parallel with products. If manifest has entries for known slugs
    // replace mediaCandidates with manifest items (prioritize manifest).
    (async () => {
      try {
        const manifest = await loadMediaManifest()
        if (manifest && Object.keys(manifest).length > 0) {
          const updated = featuredCategories.map((cat) => {
            const media = manifest[cat.slug] || manifest[cat.slug?.toLowerCase()] || []
            return { ...cat, mediaCandidates: (media.length > 0 ? media : cat.mediaCandidates) }
          })
          setFeaturedCategories(updated)
        }
      } catch (e) {
        // ignore manifest errors and fall back to defaults
      }
    })()

    loadFeaturedProducts()
  }, [])
  
  // featuredCategories is managed via state above; no duplicate constant here
  
  const handleNewsletterSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    
    if (!email.trim()) {
      setNewsletterMessage({ type: 'error', text: 'Please enter a valid email address' })
      return
    }

    if (!/\S+@\S+\.\S+/.test(email)) {
      setNewsletterMessage({ type: 'error', text: 'Please enter a valid email address' })
      return
    }

    setNewsletterLoading(true)
    setNewsletterMessage(null)

    try {
      await contactAPI.subscribeNewsletter(email)
      setNewsletterMessage({ type: 'success', text: 'Thank you for subscribing to our newsletter!' })
      setEmail('')
    } catch (error) {
      console.error('Newsletter subscription error:', error)
      setNewsletterMessage({ 
        type: 'error', 
        text: 'Failed to subscribe. Please try again later.' 
      })
    } finally {
      setNewsletterLoading(false)
    }
  }

  const displayedProducts = featuredProducts.length > 0 ? featuredProducts : mockFeaturedProducts

  return (
    <HomeContainer>
      <HeroSection>
        <HeroMedia>
          <HeroSlideshow />
        </HeroMedia>
        <HeroContent>
          <HeroTitle>ERICA SPANKS</HeroTitle>
          <HeroTagline>"Comfort that turns heads."</HeroTagline>
          <HeroSubtitle>
            Discover fashion that celebrates your confidence, embraces your comfort,
            and makes every moment feel extraordinary.
          </HeroSubtitle>
          <CTAButton to="/products">
            Shop Collection <ArrowRight size={18} />
          </CTAButton>
        </HeroContent>
      </HeroSection>
      
      <FeaturedSection>
        <SectionTitle>Featured Collections</SectionTitle>
        <CategoriesGrid>
          {featuredCategories.map((category, index) => (
            <CategoryCard key={index} to={category.link}>
              {/* Render only the top-priority media candidate (prefer video), avoid stacking multiple media elements */}
              <MediaWrapper>
                {(() => {
                  const candidate = category.mediaCandidates && category.mediaCandidates.length > 0 ? category.mediaCandidates[0] : undefined
                  if (!candidate) return null
                  const isVideo = typeof candidate === 'string' && /\.(mp4|webm|ogg)$/i.test(candidate)
                  // prefer a non-video fallback image if available
                  const fallback = (category.mediaCandidates && category.mediaCandidates.length > 1 && typeof category.mediaCandidates[1] === 'string' && !/\.(mp4|webm|ogg)$/i.test(category.mediaCandidates[1])) ? category.mediaCandidates[1] as string : 'https://res.cloudinary.com/dtnyez4fk/image/upload/v1761501832/erica-spanks/undefined/Dress_waw3fm.jpg'

                  return isVideo ? (
                    <VideoWithFallback key={index} src={candidate as string} fallbackImage={fallback} className={"category-video"} />
                  ) : (
                    <MediaImage key={index} src={candidate as string} alt={category.title} onError={(e) => { (e.currentTarget as HTMLImageElement).style.display = 'none' }} />
                  )
                })()}
              </MediaWrapper>
              <CategoryOverlay>
                <CategoryTitle>{category.title}</CategoryTitle>
                <p>{category.description}</p>
              </CategoryOverlay>
            </CategoryCard>
          ))}
        </CategoriesGrid>
      </FeaturedSection>
      
      {/* Video Showcase Section */}
      <VideoSection>
        <div>
          <SectionTitle>Runway & Lookbook</SectionTitle>
          <p style={{ color: '#666', marginBottom: '1rem' }}>
            Curated videos and images from our latest collections.
          </p>
          <MediaWrapper style={{ height: '320px', borderRadius: '12px', overflow: 'hidden' }}>
            <RunwaySlideshow />
          </MediaWrapper>
        </div>
      </VideoSection>
      
      {/* Featured Products Section */}
      <FeaturedSection>
        <SectionTitle>Featured Products</SectionTitle>
        
        {loading && (
          <LoadingState>
            <RefreshCw size={24} style={{ animation: 'spin 1s linear infinite', marginBottom: '1rem' }} />
            <div>Loading featured products...</div>
          </LoadingState>
        )}
        
        {error && (
          <ErrorState>
            {error}
            <br />
            <RetryButton onClick={loadFeaturedProducts}>
              <RefreshCw size={16} />
              Try Again
            </RetryButton>
          </ErrorState>
        )}
        
        {!loading && displayedProducts.length > 0 && (
          <>
            <ProductsGrid>
              {displayedProducts.slice(0, 4).map((product) => (
                <ProductCard
                  key={product._id}
                  product={product}
                  variant="default"
                />
              ))}
            </ProductsGrid>
            <div style={{ textAlign: 'center', marginTop: '3rem' }}>
              <CTAButton to="/products">
                View All Products <ArrowRight size={18} />
              </CTAButton>
            </div>
          </>
        )}
        
        {!loading && displayedProducts.length === 0 && (
          <ErrorState>
            No featured products available at the moment.
            <br />
            <RetryButton onClick={loadFeaturedProducts}>
              <RefreshCw size={16} />
              Try Again
            </RetryButton>
          </ErrorState>
        )}
      </FeaturedSection>
      
      <StorySection>
        <StoryContainer>
          <SectionTitle>Our Story</SectionTitle>
          <StoryText>
            Erica Spanks was born from a simple belief: every woman deserves to feel 
            confident, comfortable, and unstoppable in what she wears. We create pieces 
            that celebrate your unique beauty while ensuring you feel amazing all day long.
          </StoryText>
          <StoryText>
            From our carefully selected fabrics to our attention to fit, every detail 
            is designed with you in mind.
          </StoryText>
          <CTAButton to="/about">
            Learn More <ArrowRight size={18} />
          </CTAButton>
        </StoryContainer>
      </StorySection>
      
      <NewsletterSection>
        <NewsletterContainer>
          <SectionTitle>Stay in Touch</SectionTitle>
          <StoryText>
            Be the first to know about new arrivals, exclusive offers, and style tips 
            straight from our team.
          </StoryText>
          <NewsletterForm onSubmit={handleNewsletterSubmit}>
            <EmailInput
              type="email"
              placeholder="Enter your email address"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              required
              disabled={newsletterLoading}
            />
            <SubmitButton type="submit" disabled={newsletterLoading}>
              <Mail size={18} />
              {newsletterLoading ? 'Subscribing...' : 'Subscribe'}
            </SubmitButton>
          </NewsletterForm>
          {newsletterMessage && (
            newsletterMessage.type === 'success' ? (
              <SuccessMessage>{newsletterMessage.text}</SuccessMessage>
            ) : (
              <ErrorMessage>{newsletterMessage.text}</ErrorMessage>
            )
          )}
        </NewsletterContainer>
      </NewsletterSection>
    </HomeContainer>
  )
}

export default Home